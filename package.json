{
  "name": "woocommerce-google-analytics-integration",
  "title": "Google Analytics for WooCommerce",
  "version": "2.2.0",
  "license": "GPL-2.0",
  "homepage": "https://wordpress.org/plugins/woocommerce-google-analytics-integration/",
  "repository": {
    "type": "git",
    "url": "git://github.com/woocommerce/woocommerce-google-analytics-integration.git"
  },
  "dependencies": {
    "@wordpress/hooks": "^4.26.0",
    "@wordpress/i18n": "^5.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@wordpress/env": "^11.8.1",
    "@wordpress/eslint-plugin": "^25.4.0",
    "@wordpress/scripts": "^31.8.0",
    "@wordpress/url": "^4.26.0",
    "ajv": "^8.20.0",
    "axios": "^1.16.0",
    "eslint": "^9.39.4",
    "node-wp-i18n": "~1.2.8",
    "prettier": "npm:wp-prettier@^3.0.3"
  },
  "overrides": {
    "@babel/runtime": "^7.27.6",
    "webpack-dev-server": "^5.2.4",
    "qs": "^6.15.2",
    "uuid": "11.1.1",
    "minimatch": "^3.1.4",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    },
    "serialize-javascript": "^7.0.5",
    "schema-utils": {
      "ajv": "^8.18.0"
    },
    "ajv-formats": {
      "ajv": "^8.18.0"
    }
  },
  "assets": {
    "js": {
      "min": "assets/js/*.min.js",
      "js": "assets/js/*.js"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development wp-scripts build",
    "start": "wp-scripts start",
    "makepot": "wpi18n makepot --domain-path languages --pot-file $npm_package_name.pot --type plugin --main-file $npm_package_name.php --exclude node_modules,tests,docs,assets/js/src",
    "lint:js": "eslint .",
    "lint:php": "vendor/bin/phpcs",
    "archive": "composer archive --file=$npm_package_name --format=zip",
    "postarchive": "rm -rf $npm_package_name && unzip $npm_package_name.zip -d $npm_package_name && rm $npm_package_name.zip && zip -r $npm_package_name.zip $npm_package_name && rm -rf $npm_package_name",
    "build": "NODE_ENV=production wp-scripts build && npm run makepot &&  npm run archive",
    "prebuild": "rm -rf ./vendor",
    "test:e2e": "npx playwright test --config=tests/e2e/config/playwright.config.js",
    "test:e2e-dev": "npx playwright test --config=tests/e2e/config/playwright.config.js --debug",
    "test:php:setup": "WP_ENV_CONFIG_FILE=.wp-env.test.json ./tests/bin/setup-phpunit-env.sh",
    "test:php": "wp-env run cli --config=.wp-env.test.json --env-cwd=wp-content/plugins/woocommerce-google-analytics-integration vendor/bin/phpunit",
    "wp-env": "wp-env",
    "wp-env:up": "npm run -- wp-env start --update --config=.wp-env.test.json",
    "wp-env:down": "npm run -- wp-env stop --config=.wp-env.test.json",
    "wp-env:destroy": "npm run -- wp-env destroy --config=.wp-env.test.json",
    "wp-env:dev:up": "npm run -- wp-env start --update",
    "wp-env:dev:down": "npm run -- wp-env stop",
    "wp-env:dev:destroy": "npm run -- wp-env destroy"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.10.0"
  },
  "config": {
    "wp_org_slug": "woocommerce-google-analytics-integration",
    "version_replace_paths": [
      "includes",
      "tests",
      "woocommerce-google-analytics-integration.php"
    ]
  }
}
