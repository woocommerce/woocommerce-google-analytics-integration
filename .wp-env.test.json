{
	"phpVersion": "8.0",
	"port": 8889,
	"testsEnvironment": false,
	"plugins": [
		"https://github.com/WP-API/Basic-Auth/archive/master.zip",
		"./tests/e2e/test-data",
		"./tests/e2e/test-snippets",
		"."
	],
	"mappings": {
		"wp-cli.yml": "./tests/e2e/config/wp-cli.yml"
	},
	"lifecycleScripts": {
		"afterStart": "WP_ENV_CONFIG_FILE=.wp-env.test.json ./tests/e2e/bin/test-env-setup.sh",
		"afterClean": "WP_ENV_CONFIG_FILE=.wp-env.test.json ./tests/e2e/bin/test-env-setup.sh"
	}
}
